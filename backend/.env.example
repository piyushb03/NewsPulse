# Backend environment variables
# Copy this to .env and fill in your values

# Server
PORT=4000

# Database - SQLite (default, local dev)
DATABASE_URL=sqlite:///path/to/scraper/news_pulse.db

# Database - Production on Render (SQLite committed to Git)
# DATABASE_URL=file:///opt/render/project/src/scraper/news_pulse.db

# Database - Postgres (optional, production)
# DATABASE_URL=postgresql://user:password@host:5432/news_pulse

# Python executable path (for spawning the pipeline)
# On Windows: PYTHON_PATH=C:/absolute/path/to/scraper/venv/Scripts/python.exe
# On Render (Node runtime ships Python3):
PYTHON_PATH=python3

# Path to scraper main.py (relative to backend/ or absolute)
SCRAPER_PATH=../scraper/main.py

# CORS - comma-separated allowed frontend origins (no trailing slashes)
# Local dev:
# CORS_ORIGINS=http://localhost:3000
# Production (Render env var - add your Vercel URLs):
CORS_ORIGINS=https://news-pulse-dz1y7zusq-piyush-baghels-projects.vercel.app,https://news-pulse-kappa-seven.vercel.app

# Rate limiting on /ingest/trigger
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
