# Backend environment variables
# Copy this to .env and fill in your values

# Server
PORT=4000

# Database — SQLite (default, for local dev)
DATABASE_URL=sqlite:///path/to/scraper/news_pulse.db

# Database — Postgres (for production)
# DATABASE_URL=postgresql://user:password@host:5432/news_pulse

# Python executable path (for spawning the pipeline)
# On Windows: PYTHON_PATH=python
# On Linux/Mac: PYTHON_PATH=python3
PYTHON_PATH=python

# Path to the scraper main.py (absolute or relative to backend root)
SCRAPER_PATH=../scraper/main.py

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting on /ingest/trigger (requests per window)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
