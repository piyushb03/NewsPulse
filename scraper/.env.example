# Scraper environment variables
# Copy this file to .env and fill in your values

# Database — choose one:
# SQLite (default for local dev — leave DATABASE_URL unset or set to sqlite)
DATABASE_URL=sqlite:///news_pulse.db

# Postgres (for production — set this to your Supabase/Neon/Railway connection string)
# DATABASE_URL=postgresql://user:password@host:5432/news_pulse

# Optional: request timeout for body extraction (seconds)
FETCH_TIMEOUT=15

# Optional: max articles to process per feed per run (0 = no limit)
MAX_ARTICLES_PER_FEED=50
